{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeLedger",
  "mainBinaryName": "HomeLedger",
  "version": "1.0.0",
  "identifier": "com.hallowyeeee.homeledger",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "家庭記帳",
        "url": "app.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "languages": ["TradChinese"], "installMode": "currentUser" }
    }
  }
}
